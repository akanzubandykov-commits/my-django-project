# ЖОБА ҮЛГІСІ: ұпайларды /admin/ арқылы өз ережеңізге сай өзгертіңіз
LEVELS = [("Мектеп деңгейі", 1), ("Аудан / қала деңгейі", 2), ("Облыс деңгейі", 3),
          ("Республика деңгейі", 5), ("Халықаралық деңгей", 8)]


class Command(BaseCommand):
    help = "Санаттар мен үлгі критерийлерді жүктейді"

    def handle(self, *a, **k):
        for i, (name, grp) in enumerate(CATS, 1):
            c, _ = Category.objects.get_or_create(slug=f"c{i}",
                      defaults=dict(name=name, icon=f"i{i}", group=grp, order=i, description=DESCRIPTIONS.get(i, "")))
            if not c.description and DESCRIPTIONS.get(i):
                c.description = DESCRIPTIONS[i]
                c.save(update_fields=["description"])
            for t, p in LEVELS:
                Criterion.objects.get_or_create(category=c, title=t, defaults=dict(points=p))
        self.stdout.write(self.style.SUCCESS("Дайын"))
